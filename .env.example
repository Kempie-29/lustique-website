# Lustique Co. — environment variables
# Copy to `.env` and fill in as services are connected.

# ── Public (VITE_-prefixed; shipped to the browser) ─────────────────────────
# Supabase project URL and PUBLIC anon key. Safe to expose: all access is
# RLS-scoped, and app data lives in a dedicated `lux` schema. When ABSENT the
# portal/dashboard degrade gracefully and the public site is unchanged.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-only (NEVER VITE_-prefixed) ──────────────────────────────────────
# These live as Supabase Edge Function secrets and must never reach the browser:
#   SUPABASE_SERVICE_ROLE_KEY   — bypasses RLS; server functions only
#   YOCO_SECRET_KEY             — Yoco payment API
#   YOCO_WEBHOOK_SECRET         — verifies incoming Yoco webhooks
#   BREVO_API_KEY               — transactional email
#   GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET — calendar sync
#   CLOUDFLARE_ZONE_ID / CLOUDFLARE_API_TOKEN — cache management

# HERE API key (browser). Unlocks venue type-ahead suggestions and geocoding.
# `VITE_MAPS_API_KEY` is accepted as an alias — either name works.
# When BOTH are ABSENT the estimator still responds: the type-ahead falls back
# to the keyless OpenStreetMap Nominatim geocoder (limited to South Africa), and
# travel that cannot be resolved falls back to the manual distance-band select,
# rendering travel as "to be confirmed" — it never invents a distance or fee.
# NOTE: a browser key is public; restrict it by domain/referrer in the HERE
# console.
VITE_HERE_API_KEY=
# VITE_MAPS_API_KEY=

# Enquiry endpoint. When ABSENT the submit layer runs in dev mode:
# it validates, logs to the console, and persists to localStorage.
# When PRESENT the same payload is POSTed here with no other changes.
VITE_ENQUIRY_ENDPOINT=

# Google Analytics 4 measurement ID. Analytics only load AFTER the visitor
# accepts cookies (POPIA). When ABSENT (or left as the placeholder) nothing is
# loaded and no requests are made.
VITE_GA_ID=G-XXXXXXXXXX